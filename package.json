{
  "name": "qiye-workspace",
  "version": "1.5.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Qiye — a local workspace for browser tabs, groups and bookmarks",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release:build": "node scripts/release.mjs",
    "store:materials": "node scripts/store-materials.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:safari": "node scripts/build.mjs --target=safari",
    "package:firefox": "node scripts/package.mjs --target=firefox",
    "safari:project": "node scripts/safari-project.mjs"
  }
}
